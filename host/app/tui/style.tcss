
ModalScreen {
    content-align: center middle;
    align: center middle;
    background: $background 50%;
}

#dialog {
    width: 60%;
    min-width: 40;
    max-width: 80;
    height: auto;
}

#dialog Label {
    width: 1fr;
    text-align: center;
    margin-bottom: 1;
}

#dialog Button {
    width: 1fr;
    margin: 0 1;
}

.modal_selector {
    height: 6;
    width: 100%;
}

Screen {
    padding: 1;
    layout: vertical;
}

Label Button {
    width: 1fr;
    text-align: center;
}

.link-btn {
    width: 1fr;
    text-align: end;
    link-style: none;
    margin: 0 1;
}

.enabled {
    color: #40e36d;
    text-style: bold;
}

.disabled {
    color: red;
}

.positive{
    background: #125c26
}
.negative{
    background: #871818
}

.align-left {
    align: left middle;
}

.align-right {
    align: right middle;
}

.align-center {
    align: center middle;
    content-align: center middle;
}

.title {
    width: 1fr;
    text-align: center;
    text-style: bold;
}

/* --- Верхняя панель --- */
TopPanel {
    height: 1fr;
}

#top-panel-statistic Label {
    margin: 0 4;
    text-style: bold;
}
.slot-btn{
    height: auto;

}
.slot-btn-panel Button{
    width: 1fr;
    height: auto;
}

Button {
    margin: 0 1;
    text-align: center;
    height: 1fr;
}

/* --- Вкладки слотов --- */
.tab-panel {
    width: 100%;
    height: 1fr;
    border: tall $accent;
}

.slot-grid {
    height: 3fr;
    grid-size: 2 2;
    grid-rows: 1fr;
    grid-columns: 1fr;
    grid-gutter: 1;
}

.cell-grid {
    grid-size: 5 2;
    grid-rows: 1fr;
    grid-columns: 1fr;
    grid-gutter: 0;
}

.btn-grid {
    grid-size: 3 3;
    grid-rows: 1fr;
    grid-columns: auto;
    grid-gutter: 1;
    border: tall $accent;
}

Button.active{
    background: #135c10;
}
Button.disable{
    background: #5c1010;
}

.cell {
    height: 1fr;
    border: solid $accent;
    text-align: center;
    align: center middle;
}

.tab-item {
    height: auto;
    width: 1fr;
    padding: 1;
    margin: 1 0;
    align: center middle;
}

.left-panel {
    height: 100%;
    width: 11;
}

ListItem:hover {
    background: $primary;
}

.container {
    height: 1fr;
    width: 1fr;
    content-align: center middle;
    align: center middle;
    border: tall $accent;
}

.big {
    height: 4fr;
}

/* --- SlotLargeCard: переключение панелей --- */
SlotLargeCard .panel {
    display: none;
}

SlotLargeCard .panel.visible {
    display: block;
}

/* --- Dashboard --- */
SlotLargeCard #dashboard {
    height: 1fr;
    padding: 1;
}

SlotLargeCard #metrics-grid {
    height: 1fr;
    grid-size: 3 4;
    grid-gutter: 1;
}

SlotLargeCard .metric {
    height: 3;
    border: solid $primary;
    content-align: center middle;
    text-style: bold;
}

SlotLargeCard .metric-value {
    color: $success;
}

SlotLargeCard #status-row {
    height: 3;
    padding: 0 1;
}

SlotLargeCard .status-flag {
    margin: 0 1;
}

SlotLargeCard .status-flag.ok {
    color: $success;
}

SlotLargeCard .status-flag.off {
    color: $error;
}

SlotLargeCard #progress-section {
    height: 5;
    padding: 0 1;
}

SlotLargeCard #chart-section {
    height: 1fr;
    padding: 0 1;
    min-height: 8;
}

/* --- Logs --- */
SlotLargeCard #logs-toolbar {
    height: 3;
    padding: 0 1;
}

SlotLargeCard #log-view {
    height: 1fr;
    border: solid $primary;
}


.btn-panel{
    align: center middle;
}

.btn{
    width: 1fr;
    height: 1fr;
    margin: 1 1;
    opacity: 70%;
}

.btn:hover{
    opacity: 100%;
}

.list-item{
    width: 1fr;
    height: 1fr;
    content-align: center middle;
}

.debug{
    border: round $primary;
}

.list-item.left{
    content-align: left middle;
}
.list-item.right{
    content-align: right middle;
}

.main{
    height: 3fr;
}

.t-grid{
    layout: grid;
    grid-size: 3 2;
    grid-rows: 1fr;
    grid-columns: 1fr;
    grid-gutter: 1;
    padding: 1;
}

.grid-cell{
    width: 100%;
    height: 100%;
    content-align-horizontal: center;
    border: round $primary;
}

.higher{
    height: 2fr;
}

#dash-progress Bar {
    width: 1fr;
}